# Copy of the settings Segue needs. Do not edit this file with real values:
# run `python scripts/init_env.py` to create .env with generated secrets.

# --- Secrets (generated) ---
POSTGRES_PASSWORD=
RABBIT_PASSWORD=
PII_KEY=
JWT_SIGNING_SECRET=
# One password per staff role. Change them after first login (POST /auth/password).
SEED_PASSWORD_OPS=
SEED_PASSWORD_CREW=
SEED_PASSWORD_GROUND=
SEED_PASSWORD_AUTHORITY=
SEED_PASSWORD_ADMIN=
SEED_STAFF_PASSWORD=
REDIS_PASSWORD=

# --- Connections (inside the compose network) ---
DATABASE_URL=postgresql+asyncpg://segue:${POSTGRES_PASSWORD}@postgres:5432/segue
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
KAFKA_BROKERS=redpanda:9092
RABBIT_URL=amqp://segue:${RABBIT_PASSWORD}@rabbitmq:5672/
WEB_ORIGIN=http://localhost:3000
# Set to true when the site is served over HTTPS (for example behind ngrok), so cookies are sent only over TLS.
COOKIE_SECURE=false

# --- clef-flash (hosted on your machine) ---
MODEL_BASE_URL=http://172.16.124.162:4040
MODEL_API_KEY=local
# MODEL_NAME=

# --- AirLabs flight data ---
AIRLABS_API_KEY=
AIRLABS_BUDGET=900

# --- Privacy ---
RETENTION_HOURS=24
NOTICE_VERSION=2026-10-01
GRIEVANCE_CONTACT=privacy@segue.example

# --- Email ---
# Default: the Mailpit container, a local test inbox at http://localhost:8025. Nothing leaves this machine.
# To send real email, set these to your provider (for example smtp.gmail.com / 587 / an app password) and SMTP_STARTTLS=true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
MAIL_FROM=Segue <no-reply@segue.local>
